# AI Study Buddy Configuration

# Server
PORT=8000
HOST=127.0.0.1
DEBUG=True
DATABASE_URL=sqlite:///./study_buddy.db

# AI Providers (Optional - App runs with full built-in offline fallback engine if not provided!)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
DEFAULT_AI_PROVIDER=auto  # auto, openai, gemini, anthropic, fallback

# Code Execution Security
CODE_RUN_TIMEOUT_SECONDS=5
MAX_CODE_LENGTH=10000
